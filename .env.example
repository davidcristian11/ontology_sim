# Local environment-variable template.
#
# Never put real passwords, tokens, keys, or credentials in this file.
# Add variable names here as external services are introduced.

NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=...
NEO4J_DATABASE=neo4j

DATABRICKS_SERVER_HOSTNAME=...
DATABRICKS_HTTP_PATH=...

GRAPH_GENERATION_ID=...